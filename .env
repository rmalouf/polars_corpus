VENV_PATH="$HOME/.local/venvs/polars-corpus"

if [[ ! -d ${VENV_PATH} ]]; then
	mkdir -p ${HOME}/.local/venvs
	uv venv ${VENV_PATH} --allow-existing --quiet
fi

rm -f $AUTOENV_CUR_DIR/.venv
ln -sf ${VENV_PATH} $AUTOENV_CUR_DIR/.venv
source $AUTOENV_CUR_DIR/.venv/bin/activate
uv sync --quiet

export BROWSER=/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome
export JUPYTER_CONFIG_DIR=${VENV_PATH}/.jupyter
